{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resourceType": "Microsoft.Web/sites",
  "name": "api-hardened-payments-gateway",
  "location": "northeurope",
  "comments": "GOOD CONFIG 4: Strict CORS origin domains, Key Vault reference instead of plaintext secrets, backups active",
  "appSettings": {
    "keyVaultSecretReference": "@Microsoft.KeyVault(SecretUri=https://corp-kv.vault.azure.net/secrets/DbSecret/)"
  },
  "storage": {
    "allowBlobPublicAccess": false,
    "supportsHttpsTrafficOnly": true,
    "encryption": true
  },
  "sql": {
    "firewallRules": [
      {
        "name": "PaymentAppVNet",
        "startIpAddress": "10.2.0.1",
        "endIpAddress": "10.2.0.254"
      }
    ]
  },
  "tls": {
    "minimumVersion": "1.3"
  },
  "network": {
    "defaultAction": "Deny"
  },
  "rbac": {
    "adminScope": "resourceGroup"
  },
  "diagnostics": {
    "auditLog": true
  },
  "identity": {
    "mfaEnabled": true
  },
  "cors": {
    "allowedOrigins": [
      "https://checkout.company.com",
      "https://pay.company.com"
    ]
  },
  "backup": {
    "enabled": true
  },
  "alerts": {
    "activityLog": true
  },
  "resource": {
    "lock": true,
    "tags": {
      "PCI-DSS": "Compliant",
      "DataClass": "Restricted",
      "Owner": "Payment-Engineering"
    }
  }
}