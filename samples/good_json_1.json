{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resourceType": "Microsoft.Storage/storageAccounts",
  "name": "corpfinancesecurestorage",
  "location": "eastus2",
  "comments": "GOOD CONFIG 1: Private blob access, mandatory HTTPS, TLS 1.3, AES-256 resting encryption, read-only lock, tags",
  "storage": {
    "allowBlobPublicAccess": false,
    "supportsHttpsTrafficOnly": true,
    "encryption": true
  },
  "sql": {
    "firewallRules": [
      {
        "name": "CorpOfficeVPN",
        "startIpAddress": "198.51.100.1",
        "endIpAddress": "198.51.100.254"
      }
    ]
  },
  "tls": {
    "minimumVersion": "1.3"
  },
  "network": {
    "defaultAction": "Deny"
  },
  "rbac": {
    "adminScope": "resourceGroup"
  },
  "diagnostics": {
    "auditLog": true
  },
  "identity": {
    "mfaEnabled": true
  },
  "cors": {
    "allowedOrigins": [
      "https://portal.cloudguard.io"
    ]
  },
  "backup": {
    "enabled": true
  },
  "alerts": {
    "activityLog": true
  },
  "resource": {
    "lock": true,
    "tags": {
      "Environment": "Production",
      "Owner": "SecOps",
      "CostCenter": "FIN-104",
      "Compliance": "CIS-Azure-1.8"
    }
  }
}