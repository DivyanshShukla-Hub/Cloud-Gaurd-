{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resourceType": "Microsoft.Network/networkSecurityGroups",
  "name": "nsg-zerotrust-mesh",
  "location": "westus2",
  "comments": "GOOD CONFIG 3: Inbound default Deny, narrow resource-group scope, MFA active, activity log telemetry verified",
  "storage": {
    "allowBlobPublicAccess": false,
    "supportsHttpsTrafficOnly": true,
    "encryption": true
  },
  "sql": {
    "firewallRules": [
      {
        "name": "InternalVNet",
        "startIpAddress": "10.1.0.0",
        "endIpAddress": "10.1.255.255"
      }
    ]
  },
  "tls": {
    "minimumVersion": "1.3"
  },
  "network": {
    "defaultAction": "Deny"
  },
  "rbac": {
    "adminScope": "resourceGroup"
  },
  "diagnostics": {
    "auditLog": true
  },
  "identity": {
    "mfaEnabled": true
  },
  "cors": {
    "allowedOrigins": [
      "https://admin.cloudguard.io"
    ]
  },
  "backup": {
    "enabled": true
  },
  "alerts": {
    "activityLog": true
  },
  "resource": {
    "lock": true,
    "tags": {
      "SecurityZone": "DMZ-Internal",
      "ZeroTrust": "Enforced",
      "Owner": "DevSecOps"
    }
  }
}